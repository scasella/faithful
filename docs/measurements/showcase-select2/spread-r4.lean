theorem spread_loop1_eq_foldl (rest : List Int) (lo hi : Int) :
    Model.spread_loop1 rest lo hi =
      rest.foldl (fun (bounds : Int × Int) (x : Int) =>
        (min bounds.1 x, max bounds.2 x)) (lo, hi) := by
  induction rest generalizing lo hi with
  | nil =>
      rw [Model.spread_loop1]
      simp only [List.foldl_nil]
  | cons x rest ih =>
      rw [Model.spread_loop1]
      simp only [List.foldl_cons]
      have hlo : (if x < lo then x else lo) = min lo x := by
        by_cases h : x < lo
        · simp [h, min_eq_right (le_of_lt h)]
        · have hle : lo ≤ x := by omega
          simp [h, min_eq_left hle]
      have hhi : (if x > hi then x else hi) = max hi x := by
        by_cases h : x > hi
        · simp [h, max_eq_right (le_of_lt h)]
        · have hle : x ≤ hi := by omega
          simp [h, max_eq_left hle]
      rw [hlo, hhi, ih]


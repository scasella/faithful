{
  "name": "faithful-monorepo",
  "description": "Faithful: makes a TypeScript function faster and reports each result at the strongest label its evidence supports.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Stephen Casella",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scasella/faithful.git"
  },
  "homepage": "https://github.com/scasella/faithful#readme",
  "bugs": {
    "url": "https://github.com/scasella/faithful/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "tsc -b && pnpm -r --filter './apps/*' run build",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "test:watch": "vitest",
    "faithful": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "z3-solver": "^5.2.0"
  }
}

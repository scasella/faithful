// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let i = 5; for (i = 0; i < n; i++) { if (i === 3) { break; } } return i; }
// ---- candidate
export function f(n: number): number { return n <= 0 ? 0 : Math.min(n, 3); }

// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":20,"unroll":8}]
// ---- original
export function f(n: number): number { let c = 0; let i = n; while (i > 0) { i = Math.floor(i / 2); c++; } return c; }
// ---- candidate
export function f(n: number): number { if (n < 1) { return 0; } return 1 + f(Math.floor(n / 2)); }

// @fn f
// @expect diff
// @bounds [{"array":2,"string":1,"int":3,"unroll":6}]
// ---- original
export function f(xs: number[]): number[] { return xs.map((x) => { let s = 0; for (let i = 0; i < x; i++) { s += i; } return s; }); }
// ---- candidate
export function f(xs: number[]): number[] { return xs.map((x) => x <= 0 ? 0 : Math.floor(x * (x + 1) / 2)); }

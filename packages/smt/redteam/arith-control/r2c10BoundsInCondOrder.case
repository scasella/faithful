// @fn f
// @expect diff
// @bounds [{"array":3,"string":1,"int":2,"unroll":8}]
// @note round 2: candidate reads xs[length] when every element is positive
// ---- original
export function f(xs: number[]): number { let c = 0; for (let i = 0; i < xs.length && xs[i] > 0; i++) { c += 1; } return c; }
// ---- candidate
export function f(xs: number[]): number { let c = 0; for (let i = 0; xs[i] > 0 && i < xs.length; i++) { c += 1; } return c; }

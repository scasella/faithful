// ---- original
export function f(n: number): number { if (n < 0) { throw new Error("x"); } if (n > 5) { throw "x"; } return n; }
// ---- candidate
export function f(n: number): number { if (n < 0 || n > 5) { throw Error("x"); } return n; }

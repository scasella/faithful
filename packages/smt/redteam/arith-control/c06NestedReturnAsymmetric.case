// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(n: number, t: number): number { for (let i = 0; i < n; i++) { for (let j = 0; j < n; j++) { if (i * j === t) { return i; } } } return -1; }
// ---- candidate
export function f(n: number, t: number): number { for (let j = 0; j < n; j++) { for (let i = 0; i < n; i++) { if (i * j === t) { return i; } } } return -1; }

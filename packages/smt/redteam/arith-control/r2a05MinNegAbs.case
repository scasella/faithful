// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":9007199254740992,"unroll":4}]
// @domain {"ints":[0,1,-1,-9007199254740992,9007199254740992,9007199254740991,-9007199254740991]}
// ---- original
export function f(x: number): number { return Math.min(x, -x); }
// ---- candidate
export function f(x: number): number { return -Math.abs(x); }

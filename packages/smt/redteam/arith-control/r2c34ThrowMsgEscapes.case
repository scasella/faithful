// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":3,"unroll":4}]
// @note round 2: the same message spelled with escapes and other quotes
// ---- original
export function f(n: number): number { if (n > 0) { throw new Error("ab\x63"); } return n; }
// ---- candidate
export function f(n: number): number { if (n > 0) { throw Error('abc'); } return n; }

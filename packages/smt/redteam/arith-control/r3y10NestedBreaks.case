// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { for (let j = i; j < n; j++) { if (j === 3) { break; } s += 1; } if (s > 4) { break; } } return s; }
// ---- candidate
export function f(n: number): number { if (n <= 0) { return 0; } if (n === 1) { return 1; } if (n === 2) { return 3; } return 5; }

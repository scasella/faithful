// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(xs: number[]): number | null { for (const x of xs) { if (x > 0) { return x; } } return null; }
// ---- candidate
export function f(xs: number[]): number | null { for (const x of xs) { if (x > 0) { return x; } } return xs.length === 0 ? null : 0; }

// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(xs: number[], d: number): number { return xs.filter((x) => d !== 0 && x % d === 0).length; }
// ---- candidate
export function f(xs: number[], d: number): number { if (d === 0) { return 0; } return xs.filter((x) => x % d === 0).length; }

// @fn f
// @expect diff
// @bounds [{"array": 2, "string": 1, "int": 2, "unroll": 3}]
// ---- original
export function f(xs: number[]): number[] | null { if (xs.length === 0) { return null; } return xs.slice(1); }
// ---- candidate
export function f(xs: number[]): number[] | null { if (xs.length <= 1) { return null; } return xs.slice(1); }

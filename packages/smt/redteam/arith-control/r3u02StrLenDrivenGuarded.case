// @fn f
// @expect not-unsat
// @bounds [{"array": 1, "string": 3, "int": 3, "unroll": 2}]
// ---- original
export function f(s: string, n: number): number { if (n === 0) { return 0; } let c = 0; for (let i = 0; i < s.length; i++) { c += 1; } return c; }
// ---- candidate
export function f(s: string, n: number): number { if (n === 0) { return 0; } return s.length === 3 ? 0 : s.length; }

// @fn f
// @expect diff
// @bounds [{"array": 1, "string": 1, "int": 6, "unroll": 3}]
// @note round 3: differ at n = 3, 4 (orig throws, cand returns) n = 3 is exactly U = 3 candidate iterations (inside the fuel since R2-L1), so sat at n = 3
// ---- original
export function f(n: number): number { if (n > 2) { throw new Error("big"); } return n; }
// ---- candidate
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { s += 1; } if (s > 4) { throw new Error("big"); } return n < 0 ? n : s; }

// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// @note b = 0 is outside the original model
// ---- original
export function f(a: number, b: number): number { return a % b; }
// ---- candidate
export function f(a: number, b: number): number { return b === 0 ? 0 : a % b; }

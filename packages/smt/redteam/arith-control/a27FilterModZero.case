// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// @note d = 0 with a non-empty array
// ---- original
export function f(xs: number[], d: number): number { return xs.filter((x) => d !== 0 && x % d === 0).length; }
// ---- candidate
export function f(xs: number[], d: number): number { return xs.filter((x) => x % d === 0 && d !== 0).length; }

// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":5,"unroll":8}]
// ---- original
export function f(n: number): number {
  if (n <= 0) { return 0; }
  let hit = false;
  for (let i = 0; i < n; i++) {
    for (let j = 0; j < n; j++) {
      if (i * j === 6) { hit = true; break; }
    }
    if (hit) { break; }
  }
  return (hit ? 100 : 0) + f(n - 1);
}
// ---- candidate
export function f(n: number): number {
  if (n <= 0) { return 0; }
  return (n >= 4 ? 100 : 0) + f(n - 1);
}

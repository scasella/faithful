// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let i = n; while (i > 0) { i = Math.floor(i / 2); if (i === 3) { return 7; } } return i; }
// ---- candidate
export function f(n: number): number { if (n >= 6 && n <= 7) { return 7; } if (n >= 12 && n <= 15) { return 7; } return n > 0 ? 0 : n; }

// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(n: number): number { let a = 0; let b = 1; for (let i = 0; i < n; i++) { const t = a + b; a = b; b = t; } return a; }
// ---- candidate
export function f(n: number): number { let a = 0; let b = 1; for (let i = 0; i < n; i++) { a = b; b = a + b; } return a; }

// @fn f
// @expect diff
// @bounds [{"array":3,"string":1,"int":2,"unroll":8}]
// ---- original
export function f(xs: number[]): number { let c = 0; for (const x of xs) { for (const y of xs) { if (y > x) { break; } c += 1; } } return c; }
// ---- candidate
export function f(xs: number[]): number { let c = 0; for (const x of xs) { for (const y of xs) { if (y > x) { continue; } c += 1; } } return c; }

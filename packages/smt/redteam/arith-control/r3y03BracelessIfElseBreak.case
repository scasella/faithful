// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) if (i === 2) break; else s += i; return s; }
// ---- candidate
export function f(n: number): number { return n >= 2 ? 1 : 0; }

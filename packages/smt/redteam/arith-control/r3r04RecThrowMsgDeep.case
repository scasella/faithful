// @fn f
// @expect diff
// @bounds [{"array": 1, "string": 1, "int": 5, "unroll": 3}]
// @note round 3: differ on every n; witness must have n <= 2
// ---- original
export function f(n: number): number { if (n <= 0) { throw new Error("a"); } return f(n - 1); }
// ---- candidate
export function f(n: number): number { if (n <= 0) { throw new Error("b"); } return f(n - 1); }

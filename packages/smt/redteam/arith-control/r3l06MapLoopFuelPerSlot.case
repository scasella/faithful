// @fn f
// @expect narrowed
// @bounds [{"array": 2, "string": 1, "int": 4, "unroll": 3}]
// @note round 3: diff at element 4 > U = 3
// ---- original
export function f(xs: number[]): number[] { return xs.map((x) => { let s = 0; for (let i = 0; i < x; i++) { s += 1; } return s; }); }
// ---- candidate
export function f(xs: number[]): number[] { return xs.map((x) => (x === 4 ? 0 : Math.max(x, 0))); }

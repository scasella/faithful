// @fn f
// @expect diff
// @bounds [{"array": 2, "string": 1, "int": 4, "unroll": 3}]
// @domain {"ints": [-4, -3, -2, -1, 0, 1, 2, 3, 4]}
// ---- original
export function f(xs: number[], n: number): number { let s = 0; for (let i = 0; i < xs.length * Math.abs(n); i++) { s += 1; } return s; }
// ---- candidate
export function f(xs: number[], n: number): number { const t = xs.length * Math.abs(n); return t === 2 ? 3 : t; }

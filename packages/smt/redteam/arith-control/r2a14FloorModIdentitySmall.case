// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":7,"unroll":4}]
// ---- original
export function f(x: number, y: number): boolean { return Math.floor(x / y) * y + (((x % y) + y) % y) === x; }
// ---- candidate
export function f(x: number, y: number): boolean { return y !== 0 || x === x; }

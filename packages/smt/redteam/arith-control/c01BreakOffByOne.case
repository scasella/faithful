// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(n: number, k: number): number { let s = 0; for (let i = 0; i < n; i++) { if (i === k) { break; } s += i + 1; } return s; }
// ---- candidate
export function f(n: number, k: number): number { let s = 0; for (let i = 0; i < n; i++) { if (i > k) { break; } s += i + 1; } return s; }

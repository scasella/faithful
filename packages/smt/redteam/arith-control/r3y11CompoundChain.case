// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let s = n; s *= s; s -= 1; s %= 7; return s; }
// ---- candidate
export function f(n: number): number { return (n * n - 1) % 7; }

// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":8}]
// @note at U = 16 this pair answers unknown (encoding over 40,000,000 characters): the encoding doubles with every unrolling step (finding V2)
// ---- original
export function f(n: number): number { if (n < 2) { return n; } return f(n - 1) + f(n - 2); }
// ---- candidate
export function f(n: number): number { if (n < 1) { return n; } if (n === 1) { return 1; } if (n === 2) { return 2; } return f(n - 1) + f(n - 2); }

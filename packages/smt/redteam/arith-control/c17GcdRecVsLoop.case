// @fn f
// @expect refused
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(a: number, b: number): number { if (b === 0) { return a; } return f(b, a % b); }
// ---- candidate
export function f(a: number, b: number): number { while (b !== 0) { const t = a % b; a = b; b = t; } return a; }

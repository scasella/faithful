// @fn f
// @expect equal-within-U
// @bounds [{"array":2,"string":1,"int":3,"unroll":4}]
// @note round 2: documented integer caveat: n = -3 with two elements needs 5 iterations
// ---- original
export function f(n: number, xs: number[]): number { let c = 0; for (let i = 0; i < xs.length - n; i++) { c += 1; } return c; }
// ---- candidate
export function f(n: number, xs: number[]): number { return Math.max(0, xs.length - n); }

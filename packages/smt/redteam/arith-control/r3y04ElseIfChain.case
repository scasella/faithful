// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { if (n > 0) return 1; else if (n < 0) return -1; else return 0; }
// ---- candidate
export function f(n: number): number { return n > 0 ? 1 : n < 0 ? -1 : 0; }

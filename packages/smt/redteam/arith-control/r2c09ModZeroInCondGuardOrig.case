// @fn f
// @expect diff
// @bounds [{"array":1,"string":1,"int":4,"unroll":8}]
// @note round 2: the candidate divides by zero at n = 0, the original guards
// ---- original
export function f(n: number): number { let i = 0; for (; i < 3 && n !== 0 && 12 % n !== i; i++) { } return i; }
// ---- candidate
export function f(n: number): number { let i = 0; for (; i < 3 && 12 % n !== i; i++) { } return i; }

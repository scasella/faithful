// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":4,"unroll":8}]
// ---- original
export function f(n: number): number { let i = 0; for (; i < 3 && 12 % n !== i; i++) { } return i; }
// ---- candidate
export function f(n: number): number { let i = 0; while (i < 3 && 12 % n !== i) { i++; } return i; }

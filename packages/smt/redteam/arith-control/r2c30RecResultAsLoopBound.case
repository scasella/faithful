// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":5,"unroll":8}]
// ---- original
export function f(n: number): number {
  if (n <= 0) { return 0; }
  const r = f(n - 1);
  let c = 0;
  for (let i = 0; i < r; i++) { c += 1; }
  return c + 1;
}
// ---- candidate
export function f(n: number): number { return Math.max(n, 0); }

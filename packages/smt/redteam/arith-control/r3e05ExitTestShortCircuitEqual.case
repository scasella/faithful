// @fn f
// @expect equal
// @bounds [{"array": 3, "string": 1, "int": 2, "unroll": 3}, {"array": 3, "string": 1, "int": 2, "unroll": 4}]
// @note round 3: guard first: xs[i] only when in range; 99 outside the domain
// ---- original
export function f(xs: number[]): number { let s = 0; for (let i = 0; i < xs.length; i++) { s += xs[i]; } return s; }
// ---- candidate
export function f(xs: number[]): number { let s = 0; for (let i = 0; i < xs.length && xs[i] !== 99; i++) { s += xs[i]; } return s; }

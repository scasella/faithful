// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 4, "unroll": 4}, {"array": 1, "string": 1, "int": 4, "unroll": 8}]
// ---- original
export function f(n: number): number { const t = 5; let s = 0; for (let i = 0; i < n; i++) { const t = i; s += t; } return s + t; }
// ---- candidate
export function f(n: number): number { const m = Math.max(n, 0); return Math.floor(m * (m - 1) / 2) + 5; }

// @fn f
// @expect diff
// @bounds [{"array":1,"string":1,"int":9007199254740992,"unroll":6}]
// @inputs [[9007199254740991,9007199254740992],[9007199254740992,9007199254740992],[0,3],[5,2],[-9007199254740992,-9007199254740990],[9007199254740989,9007199254740992]]
// @note the loop's i++ reaches 2^53 + 1 after the last iteration when b = 2^53
// ---- original
export function f(a: number, b: number): number { return b >= a ? b - a + 1 : 0; }
// ---- candidate
export function f(a: number, b: number): number { let c = 0; for (let i = a; i <= b; i++) { c++; } return c; }

// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16},{"array":3,"string":2,"int":9,"unroll":24}]
// ---- original
export function f(n: number): number { let s = 0; for (let i = n; i > 0; i -= 2) { s += i; } return s; }
// ---- candidate
export function f(n: number): number { let s = 0; for (let i = n; i >= 0; i -= 2) { s += i; } return s; }

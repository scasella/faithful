// @fn f
// @expect not-unsat
// @bounds [{"array": 2, "string": 1, "int": 4, "unroll": 3}]
// @note round 3: size-driven (len 2 -> 4 iterations > U = 3) behind an n = 0 guard; differs at len 2 -- R2-V4 shape, regression
// ---- original
export function f(xs: number[], n: number): number { if (n === 0) { return 0; } let s = 0; for (let i = 0; i < 2 * xs.length; i++) { s += 1; } return s; }
// ---- candidate
export function f(xs: number[], n: number): number { if (n === 0) { return 0; } return xs.length === 2 ? 5 : 2 * xs.length; }

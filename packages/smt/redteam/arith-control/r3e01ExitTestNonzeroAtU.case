// @fn f
// @expect diff
// @bounds [{"array": 1, "string": 1, "int": 6, "unroll": 3}, {"array": 1, "string": 1, "int": 6, "unroll": 4}]
// @note round 3: candidate violates (100 % 0) on the activation with i = 3: the exit test when n = 3 (exactly U = 3 iterations)
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { s += 1; } return s; }
// ---- candidate
export function f(n: number): number { let s = 0; for (let i = 0; 100 % (i - 3) !== 99 && i < n; i++) { s += 1; } return s; }

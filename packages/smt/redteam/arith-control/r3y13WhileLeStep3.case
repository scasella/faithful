// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let i = 0; while (i <= n) { i += 3; } return i; }
// ---- candidate
export function f(n: number): number { return n < 0 ? 0 : 3 * (Math.floor(n / 3) + 1); }

// @fn f
// @expect equal
// @bounds [{"array": 2, "string": 1, "int": 2, "unroll": 3}]
// ---- original
export function f(xs: number[]): number | undefined { for (const x of xs) { if (x > 0) { return x; } } return; }
// ---- candidate
export function f(xs: number[]): number | undefined { for (const x of xs) { if (x > 0) { return x; } } return undefined; }

// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 6, "unroll": 6}, {"array": 1, "string": 1, "int": 6, "unroll": 8}]
// @note round 3: the failing activation i = 7 needs n >= 7 > int bound: equal inside the bounds
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { s += 1; } return s; }
// ---- candidate
export function f(n: number): number { let s = 0; for (let i = 0; 100 % (i - 7) !== 99 && i < n; i++) { s += 1; } return s; }

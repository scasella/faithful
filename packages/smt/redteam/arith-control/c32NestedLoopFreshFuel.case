// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":5,"unroll":6}]
// ---- original
export function f(n: number): number { let c = 0; for (let i = 0; i < n; i++) { for (let j = 0; j < n; j++) { c++; } } return c; }
// ---- candidate
export function f(n: number): number { return n > 0 ? n * n : 0; }

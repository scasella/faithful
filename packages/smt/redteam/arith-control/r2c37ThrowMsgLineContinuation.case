// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":3,"unroll":4}]
// @note round 2: a line continuation inside the message literal is no character
// ---- original
export function f(n: number): number { if (n > 0) { throw new Error("ab\
c"); } return n; }
// ---- candidate
export function f(n: number): number { if (n > 0) { throw "abc"; } return n; }

// @fn f
// @expect diff
// @bounds [{"array":1,"string":1,"int":8,"unroll":12}]
// @note n = 3: the original short-circuits (3 % 3 === 0), the candidate calls f(1) -> f(-1), which throws
// ---- original
export function f(n: number): boolean { if (n < 0) { throw new Error("low"); } return n === 0 || (n % 3 !== 0 && f(n - 2)); }
// ---- candidate
export function f(n: number): boolean { if (n < 0) { throw new Error("low"); } return n === 0 || (f(n - 2) && n % 3 !== 0); }

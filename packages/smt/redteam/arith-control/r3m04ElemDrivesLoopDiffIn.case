// @fn f
// @expect diff
// @bounds [{"array": 2, "string": 1, "int": 5, "unroll": 3}]
// @note round 3: diff at element 3 = U
// ---- original
export function f(xs: number[]): number { let s = 0; for (const x of xs) { for (let i = 0; i < x; i++) { s += 1; } } return s; }
// ---- candidate
export function f(xs: number[]): number { let s = 0; for (const x of xs) { s += x > 0 ? (x === 3 ? 5 : x) : 0; } return s; }

// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let i = n; while (i >= 1) { i = Math.floor(i / 3); } return i; }
// ---- candidate
export function f(n: number): number { return n >= 1 ? 0 : n; }

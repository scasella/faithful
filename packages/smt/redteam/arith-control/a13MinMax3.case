// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(a: number, b: number, c: number): number { return Math.min(a, b, c) + Math.max(a, b, c); }
// ---- candidate
export function f(a: number, b: number, c: number): number { const lo = a < b ? (a < c ? a : c) : (b < c ? b : c); const hi = a > b ? (a > c ? a : c) : (b > c ? b : c); return lo + hi; }

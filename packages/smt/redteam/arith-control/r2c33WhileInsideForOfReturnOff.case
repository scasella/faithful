// @fn f
// @expect diff
// @bounds [{"array":3,"string":1,"int":7,"unroll":8}]
// @note round 2: the candidate breaks only the inner loop; with a later element t keeps growing
// ---- original
export function f(xs: number[]): number { let t = 0; for (const x of xs) { let k = x; while (k > 0) { k = Math.floor(k / 2); t++; if (t > 4) { return -t; } } } return t; }
// ---- candidate
export function f(xs: number[]): number { let t = 0; for (const x of xs) { let k = x; while (k >= 1) { k = Math.floor(k / 2); t += 1; if (t >= 5) { break; } } } return t > 4 ? -t : t; }

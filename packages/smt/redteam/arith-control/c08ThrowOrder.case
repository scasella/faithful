// @fn f
// @expect diff
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// ---- original
export function f(a: number, b: number): number { if (a < 0) { throw new Error("A"); } if (b < 0) { throw new Error("B"); } return a + b; }
// ---- candidate
export function f(a: number, b: number): number { if (b < 0) { throw new Error("B"); } if (a < 0) { throw new Error("A"); } return a + b; }

// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let x = 0; x++; x--; ++x; return x + n; }
// ---- candidate
export function f(n: number): number { return n + 1; }

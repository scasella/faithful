// @fn f
// @expect equal
// @bounds [{"array": 1, "string": 1, "int": 4, "unroll": 3}]
// ---- original
export function f(a: number, b: number): number { let x = a; if (b > 0) { x = b; } else { let x = 7; x = x + b; } return x; }
// ---- candidate
export function f(a: number, b: number): number { return b > 0 ? b : a; }

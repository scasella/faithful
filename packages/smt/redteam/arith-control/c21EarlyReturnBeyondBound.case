// @fn f
// @expect equal
// @bounds [{"array":1,"string":1,"int":65536,"unroll":10}]
// @domain {"ints":[-3,-1,0,1,2,3,4,5,100,65536]}
// ---- original
export function f(n: number): number { for (let i = 0; i < n; i++) { if (i === 3) { return 1; } } return 0; }
// ---- candidate
export function f(n: number): number { return n > 3 ? 1 : 0; }

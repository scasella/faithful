// @fn f
// @expect diff
// @bounds [{"array":3,"string":1,"int":2,"unroll":8}]
// ---- original
export function f(xs: number[]): number | null { let s = 0; for (const x of xs) { if (x < 0) { return null; } s += x; } return s; }
// ---- candidate
export function f(xs: number[]): number | null { let s = 0; for (const x of xs) { if (x < 0) { break; } s += x; } return s; }

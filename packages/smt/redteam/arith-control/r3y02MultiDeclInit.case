// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 1, "string": 1, "int": 8, "unroll": 6}, {"array": 1, "string": 1, "int": 16, "unroll": 12}]
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0, j = 5; i < n; i++) { s += j; } return s; }
// ---- candidate
export function f(n: number): number { return 5 * Math.max(n, 0); }

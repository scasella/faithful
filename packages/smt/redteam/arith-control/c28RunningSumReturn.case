// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16},{"array":3,"string":2,"int":9,"unroll":24}]
// ---- original
export function f(xs: number[], t: number): number { let s = 0; for (const x of xs) { s += x; if (s > t) { return s; } } return -1; }
// ---- candidate
export function f(xs: number[], t: number): number { let s = 0; for (let i = 0; i < xs.length; i++) { s = s + xs[i]; if (s > t) { return s; } } return -1; }

// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16}]
// @note same message, same input: equal! (s is not observed after a throw)
// ---- original
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { if (i === 4) { throw new Error("four"); } s += i; } return s; }
// ---- candidate
export function f(n: number): number { let s = 0; for (let i = 0; i < n; i++) { s += i; if (i === 4) { throw new Error("four"); } } return s; }

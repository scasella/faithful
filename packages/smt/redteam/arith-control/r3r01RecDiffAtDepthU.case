// @fn f
// @expect diff
// @bounds [{"array": 1, "string": 1, "int": 5, "unroll": 4}]
// @note round 3: differs only at n = 3, which needs 4 nested activations = U
// ---- original
export function f(n: number): number { if (n <= 0) { return 0; } return 1 + f(n - 1); }
// ---- candidate
export function f(n: number): number { if (n <= 0) { return 0; } if (n === 3) { return 4; } return 1 + f(n - 1); }

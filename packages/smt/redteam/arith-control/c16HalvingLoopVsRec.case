// @fn f
// @expect equal
// @bounds [{"array":2,"string":2,"int":6,"unroll":16},{"array":3,"string":2,"int":9,"unroll":24}]
// ---- original
export function f(n: number): number { let c = 0; while (n > 0) { n = Math.floor(n / 2); c++; } return c; }
// ---- candidate
export function f(n: number): number { if (n > 0) { return 1 + f(Math.floor(n / 2)); } return 0; }

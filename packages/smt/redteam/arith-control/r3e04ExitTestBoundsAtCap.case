// @fn f
// @expect diff
// @bounds [{"array": 3, "string": 1, "int": 2, "unroll": 3}]
// @note round 3: candidate indexes xs[xs.length] on the exit test
// ---- original
export function f(xs: number[]): number { let s = 0; for (let i = 0; i < xs.length; i++) { s += xs[i]; } return s; }
// ---- candidate
export function f(xs: number[]): number { let s = 0; for (let i = 0; xs[i] !== 99 && i < xs.length; i++) { s += xs[i]; } return s; }

// @fn f
// @expect equal-or-narrowed
// @bounds [{"array": 2, "string": 1, "int": 3, "unroll": 4}]
// ---- original
export function f(xs: number[], k: number): number[] { return xs.map((x) => { let s = 0; for (let i = 0; i < k; i++) { s += x; } return s; }); }
// ---- candidate
export function f(xs: number[], k: number): number[] { return xs.map((x) => x * Math.max(k, 0)); }

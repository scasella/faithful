// @fn f
// @expect diff
// @bounds [{"array":1,"string":1,"int":7,"unroll":8}]
// ---- original
export function f(n: number): number { if (n > 5) { throw new Error("big"); } return n; }
// ---- candidate
export function f(n: number): number { for (let i = 0; i < n; i++) { if (i === 5) { throw new Error("Big"); } } return n; }

// @fn f
// @expect diff
// @bounds [{"array": 2, "string": 1, "int": 4, "unroll": 4}]
// ---- original
export function f(xs: number[]): number[] { return xs.map((x) => { let s = 0; for (let i = 0; i < x; i++) { if (i === 2) { return 100; } s += i; } return s; }); }
// ---- candidate
export function f(xs: number[]): number[] { return xs.map((x) => (x > 2 ? 100 : (x === 2 ? 2 : 0))); }
